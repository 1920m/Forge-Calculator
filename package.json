{
  "name": "forge-calculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:build": "node scripts/build-catalogue.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "builds:armour": "rolldown scripts/best-armour.ts --file .tmp/best-armour.mjs --platform node --format esm && node .tmp/best-armour.mjs"
  },
  "dependencies": {
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "motion": "12.23.12",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
