{
  "name": "forge-calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:extract": "node scripts/extract-prd.mjs",
    "data:audit": "node scripts/audit-wiki-ores.mjs",
    "data:seed": "node scripts/build-seed.mjs",
    "data:smoke": "node scripts/smoke-data.mjs",
    "data:check": "node scripts/extract-prd.mjs --check && node scripts/audit-wiki-ores.mjs --check && node scripts/build-seed.mjs --check",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
